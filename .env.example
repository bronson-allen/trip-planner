# Public Mapbox token only (starts with pk.) — never use a secret sk. token in the browser.
# Create one at https://account.mapbox.com/access-tokens/
# Signs map tiles, walking-route requests and the static place thumbnails.
MAPBOX_API_KEY=pk.YOUR_PUBLIC_TOKEN

# Server-side only. Used by /api/assistant and never exposed by Vite.
OPENAI_API_KEY=YOUR_OPENAI_API_KEY

# Optional production CORS allowlist, for example https://your-project.vercel.app
APP_ORIGIN=
